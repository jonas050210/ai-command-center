# ── AI Command Center configuration ────────────────────────────────
# Copy this file to ".env" and adjust. Environment variables win over .env.

# Server bind (local-first: keep 127.0.0.1 unless you know why)
HOST=127.0.0.1
PORT=8000

# Data directory (database, logs, encrypted keys, workspace)
DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Ollama ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Default chat model (change freely — nothing is hardcoded elsewhere)
DEFAULT_MODEL=qwen3:0.6b
# Context window passed to Ollama (tokens). 8192 is comfortable on 8GB VRAM.
OLLAMA_NUM_CTX=8192
# Keep model loaded in VRAM for faster follow-ups
OLLAMA_KEEP_ALIVE=10m
# Network timeout talking to Ollama (seconds)
OLLAMA_TIMEOUT=300

# ── Strict €0 cost protection (HARD SAFETY — on by default) ────────
# When true, only models whose cost is €0.00 may be used. Paid provider
# requests are blocked in the backend BEFORE any network call is made.
FREE_ONLY=true
# Absolute lifetime budget in EUR. Requests that would exceed it are blocked.
MAX_SPEND=0.00

# ── Security ───────────────────────────────────────────────────────
# Master key for encrypted provider credentials (Fernet). If unset, a key is
# generated once and stored with restricted permissions in <DATA_DIR>/secret.key
# AI_CC_SECRET_KEY=

# API token for non-loopback access. Only REQUIRED when HOST is not loopback.
# If unset, one is generated on demand into <DATA_DIR>/api.token (chmod 600).
# AI_CC_API_TOKEN=

# Extra Host header names to accept (comma-separated) when binding off-loopback,
# e.g. a LAN DNS name. Loopback names are always accepted.
# EXTRA_ALLOWED_HOSTS=

# Allowed browser origins for CORS (comma-separated). The production build is
# served by the backend itself, so defaults only cover the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Built-in rate limiting on sensitive endpoints (recommended: keep on)
ENABLE_RATE_LIMITS=true

# Log rotation: JSON log rotates at LOG_MAX_BYTES, keeping LOG_BACKUPS archives
LOG_MAX_BYTES=5000000
LOG_BACKUPS=3

# Default provider used when a request doesn't name one
DEFAULT_PROVIDER=ollama

# EUR per 1 USD — cloud providers price in USD; catalog + CostGuard are EUR
EUR_PER_USD=0.92

# Display/accounting currency (EUR strongly recommended with FREE_ONLY)
CURRENCY=EUR

# ── OpenRouter (optional free-tier cloud provider) ─────────────────
# Override only for a compatible endpoint/proxy; the API key is set in the
# app (Model Center → Providers) and stored Fernet-encrypted, never here.
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Root folder future agents/tools are allowed to touch (Phase 4+ sandbox)
WORKSPACE_ROOT=./data/workspace
