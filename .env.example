# ── AI Command Center configuration ────────────────────────────────
# Copy this file to ".env" and adjust. Environment variables win over .env.

# Server bind (local-first: keep 127.0.0.1 unless you know why)
HOST=127.0.0.1
PORT=8000

# Data directory (database, logs, encrypted keys, workspace)
DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Ollama ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Default chat model (change freely — nothing is hardcoded elsewhere)
DEFAULT_MODEL=qwen3:0.6b
# Context window passed to Ollama (tokens). 8192 is comfortable on 8GB VRAM.
OLLAMA_NUM_CTX=8192
# Keep model loaded in VRAM for faster follow-ups
OLLAMA_KEEP_ALIVE=10m
# Network timeout talking to Ollama (seconds)
OLLAMA_TIMEOUT=300

# ── Strict €0 cost protection (HARD SAFETY — on by default) ────────
# When true, only models whose cost is €0.00 may be used. Paid provider
# requests are blocked in the backend BEFORE any network call is made.
FREE_ONLY=true
# Absolute lifetime budget in EUR. Requests that would exceed it are blocked.
MAX_SPEND=0.00

# ── Security ───────────────────────────────────────────────────────
# Master key for encrypted provider credentials (Fernet). If unset, a key is
# generated once and stored with restricted permissions in <DATA_DIR>/secret.key
# AI_CC_SECRET_KEY=

# Root folder future agents/tools are allowed to touch (Phase 4+ sandbox)
WORKSPACE_ROOT=./data/workspace

# ── Agent / Team / Research behavior ─────────────────────────────────
# Max tool steps per agent run (3..100)
AGENT_MAX_STEPS=20
# How many fix rounds after verification failures (0..10)
AGENT_MAX_FIX_ROUNDS=2
# Command timeout for agent shell actions (seconds, 5..300)
AGENT_CMD_TIMEOUT=120
# Review/fix rounds in Team Mode (0..6)
TEAM_MAX_ROUNDS=2
# Research search engine: duckduckgo | disabled
SEARCH_ENGINE=duckduckgo
# Max sources per research run (1..8)
RESEARCH_MAX_SOURCES=5

# ── GitHub (optional, only enables GitHub features when set) ─────────
# GITHUB_TOKEN=ghp_xxx
# (or store it encrypted at runtime via /api/github/credentials)
